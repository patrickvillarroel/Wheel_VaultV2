# ---------------------------------------------------------------------------
# Copia este archivo a `api/.env` y rellena los valores.
# `api/.env` esta en .gitignore: NUNCA lo subas al repositorio.
# Donde obtener cada valor: docs/supabase-setup.md
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- OBLIGATORIAS ----------------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > anon / public
# Es una clave PUBLICA por diseño: su seguridad depende de las policies RLS.
SUPABASE_ANON_KEY=

# --- OPCIONALES ------------------------------------------------------------

# Supabase > Project Settings > API Keys > service_role (SECRETO)
# La API NO lo necesita: consulta Supabase con la anon key mas el JWT del
# usuario para que la RLS siga aplicando (ADR-002). Solo lo usan los scripts
# administrativos. Dejalo vacio salvo que vayas a correr uno.
# Si lo pones: ignora toda la RLS. Nunca en la app movil, nunca en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > JWT Keys > "legacy JWT secret"
# Solo necesario si tu proyecto todavia firma con el secreto compartido
# (HS256). Los proyectos nuevos usan claves asimetricas y se verifican contra
# el JWKS publico, sin ningun secreto. Dejalo vacio y la API lo detecta sola.
SUPABASE_JWT_SECRET=

# Origenes permitidos por CORS, separados por coma (Expo web en desarrollo).
# Las apps nativas no envian Origin y no se ven afectadas por CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Nivel de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
