# ---------------------------------------------------------------------------
# Copia este archivo a `api/.env` y rellena los valores.
# `api/.env` esta en .gitignore: NUNCA lo subas al repositorio.
# Donde obtener cada valor: docs/supabase-setup.md
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > anon / public
# Es una clave PUBLICA por diseño: su seguridad depende de las policies RLS.
SUPABASE_ANON_KEY=

# Supabase > Project Settings > API Keys > service_role (SECRET)
# Ignora RLS por completo. Solo para scripts administrativos, NUNCA en el
# camino de un request de usuario y NUNCA dentro de la app movil (ADR-002).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > API > JWT Settings > JWT Secret
# Se usa para verificar la firma de los tokens que llegan del movil.
SUPABASE_JWT_SECRET=

# Origenes permitidos por CORS, separados por coma (Expo web en desarrollo).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Nivel de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
