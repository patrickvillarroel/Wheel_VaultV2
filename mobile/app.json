{
  "expo": {
    "name": "Collectors Project",
    "slug": "collectors-project",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wheelvault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.collectorsproject.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.collectorsproject.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/LogotipoB.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Collectors Project usa la cámara para escanear el blister de tus carritos y recortarlo automáticamente."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ca15297-1efe-4593-8f35-3a529aaacd15"
      }
    },
    "owner": "patrichenko",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8ca15297-1efe-4593-8f35-3a529aaacd15"
    }
  }
}
