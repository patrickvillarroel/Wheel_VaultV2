# ---------------------------------------------------------------------------
# Copia este archivo a `mobile/.env`.
#
# TODO lo que lleve el prefijo EXPO_PUBLIC_ se incrusta en el bundle de la app
# y es EXTRAIBLE de cualquier .apk o .ipa. Aqui solo pueden ir valores publicos.
#
# NUNCA pongas aqui: SUPABASE_SERVICE_ROLE_KEY, JWT secrets, credenciales de
# base de datos ni claves de ningun servicio de pago.
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > anon / public
# Publica por diseño: su seguridad depende de las policies RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL de la API de Express.
#
#   Emulador de Android ....... http://10.0.2.2:4000
#   Simulador de iOS .......... http://localhost:4000
#   Movil fisico con Expo Go .. http://TU_IP_LOCAL:4000   (ej. 192.168.1.42)
#   Navegador (expo start --web) http://localhost:4000
#
# Para saber tu IP local en Windows:  ipconfig
EXPO_PUBLIC_API_URL=http://localhost:4000
