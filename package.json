{
  "name": "wheel-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Collector's Project — app para administrar una coleccion de carros a escala",
  "workspaces": [
    "shared",
    "api",
    "mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=shared && npm run build --workspace=api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run lint --workspace=mobile",
    "lint:fix": "eslint . --fix && npm run lint --workspace=mobile -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:types": "node scripts/gen-types.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "dev:mobile": "npm run start --workspace=mobile",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
